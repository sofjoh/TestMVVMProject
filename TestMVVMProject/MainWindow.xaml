<Window x:Class="TestMVVMProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TestMVVMProject.ViewModels"
        mc:Ignorable="d"
        Title="Simple MVVM"
        Width="500"
        Height="350"
        d:DataContext="{d:DesignInstance Type=vm:MainShellViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            FontSize="28"
            Text="Har ingen bindning" />
        <ContentControl
            Grid.Row="1"
            Content="{Binding CurrentGame}" />
    </Grid>
</Window>

