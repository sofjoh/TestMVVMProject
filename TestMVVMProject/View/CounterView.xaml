<UserControl x:Class="TestMVVMProject.View.CounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="30">
            <TextBlock 
                FontSize="28"
                Text="Ingen bindning" />
            <TextBlock
                Margin="0,20,0,0"
                FontSize="22"
                Text="{Binding Count}"
                />
            <Button
                Margin="0,20,0,0"
                Padding="15,8"
                Content="Öka"
                Command="{Binding IncreaseCommand}" />

        </StackPanel>
</UserControl>
