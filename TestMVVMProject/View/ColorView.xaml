<UserControl x:Class="TestMVVMProject.View.ColorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestMVVMProject.View"
             xmlns:converters="clr-namespace:TestMVVMProject.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:colorConverter x:Key="ClickedToBrushConverter"/>
    </UserControl.Resources>
    <Grid>
        <Button Content="Byt färg"
                HorizontalAlignment="Center" 
                Margin="0,281,0,0" 
                VerticalAlignment="Top" 
                Height="46" 
                Width="168"
                Command="{Binding IsClickedCommand}"/>
        <Rectangle HorizontalAlignment="Center" 
                   Height="100" 
                   Stroke="Black"
                   Fill="{Binding IsClicked, Converter={StaticResource ClickedToBrushConverter}}"
                   VerticalAlignment="Center" 
                   Width="304"
                   />

    </Grid>
</UserControl>
